{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-glance",
  "version": "0.1.0",
  "description": "Glanceable session stats for OpenCode: turns, steps, throughput, tokens, cache hit, context usage, and live tool activity.",
  "type": "module",
  "license": "MIT",
  "author": "Rosario Weynand",
  "homepage": "https://github.com/penn0312/opencode-glance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penn0312/opencode-glance.git"
  },
  "bugs": {
    "url": "https://github.com/penn0312/opencode-glance/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "statusline",
    "tokens",
    "cache",
    "context",
    "tui",
    "desktop"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.7"
  }
}
