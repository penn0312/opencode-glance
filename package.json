{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-glance",
  "version": "0.1.0",
  "private": true,
  "description": "Glanceable session stats for OpenCode: turns, steps, throughput, total tokens, cache hit and context usage.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.0",
    "@opencode/theme": "^2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
